{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm exec concurrently \"pnpm --filter @workspace/admin dev\" \"pnpm --filter @workspace/api-server dev\" \"pnpm --filter @workspace/onoot-boutique dev\"",
    "build": "pnpm build:api",
    "start": "pnpm start:api",
    "build:api": "pnpm --filter @workspace/api-server build",
    "start:api": "node --enable-source-maps Onoot-Boutique/api-server/dist/index.mjs",
    "build:admin": "pnpm --filter @workspace/admin build",
    "build:boutique": "pnpm --filter @workspace/onoot-boutique build"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^8.2.2",
    "autoprefixer": "^10.5.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
