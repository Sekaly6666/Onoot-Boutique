# Cette option permet de rendre les exécutables (comme vite) accessibles dans les sous-projets.
public-hoist-pattern[]=*

# Empêcher les invites interactives en CI (évite l'erreur exit status 254 sur Render)
confirmModulesPurge=false

# Éviter les erreurs de synchronisation lockfile strictes sur CI
frozen-lockfile=false
prefer-frozen-lockfile=false
auto-install-peers=true
node-linker=hoisted